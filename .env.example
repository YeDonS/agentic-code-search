# demo is deterministic and only accepts the bundled checkout scenario.
ASSISTANT_MODE=demo
ASSISTANT_WORKSPACE_ROOT=examples
ASSISTANT_RUNS_DIR=runs
ASSISTANT_TEST_EXECUTOR=disabled
# For real tool-calling agents: ASSISTANT_MODE=model
ASSISTANT_MODEL=anthropic:claude-sonnet-4-5-20250929
# ANTHROPIC_API_KEY=
# Or set ASSISTANT_MODEL=openai:<your-tool-capable-model> and OPENAI_API_KEY.
# Local Codex CLI alternative (uses its own saved login; no API key export):
# ASSISTANT_MODEL=codex-cli:gpt-6.1-sol
# ASSISTANT_CODEX_REASONING_EFFORT=medium
# ASSISTANT_CODEX_TRANSPORT=https  # optional: avoid WebSocket fallback on restricted networks
# Set a random token before exposing the service beyond loopback.
# ASSISTANT_API_TOKEN=
# Local execution runs repository code. Enable only for a trusted repository.
# ASSISTANT_TEST_EXECUTOR=local
# Docker execution is available from the host CLI; do not mount a Docker socket into the API.
# ASSISTANT_TEST_EXECUTOR=docker
ASSISTANT_TEST_IMAGE=code-assistant-test:local
# Optional evidence/format-repair controls (new runs only; never resume old settings):
ASSISTANT_EVIDENCE_POLICY=source_priority
ASSISTANT_PATCH_REPAIR_ATTEMPTS=2
ASSISTANT_MAX_MODEL_CALLS=18
ASSISTANT_MAX_AGENT_STEPS=7
ASSISTANT_MAX_TOOL_CALLS=18
# ASSISTANT_WORKFLOW=single  # use ASSISTANT_PATCH_REPAIR_ATTEMPTS=0 for a pure baseline
